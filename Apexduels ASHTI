    const float enemyRange    = 2.5f;
    const float enemyCd       = 1.25f;
    const float speedTol      = 1.10f;   
    const float rangeTol      = 1.15f;
    const float teleportDist  = 8.0f;    
    const int   strikeWarn    = 4;       
    const int   strikeKick    = 8;       
