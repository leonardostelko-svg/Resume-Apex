struct Vec2 {
    float x, y;
    Vec2() : x(0), y(0) {}
    Vec2(float x_, float y_) : x(x_), y(y_) {}
    Vec2 operator+(const Vec2& o) const { return Vec2(x + o.x, y + o.y); }
    Vec2 operator-(const Vec2& o) const { return Vec2(x - o.x, y - o.y); }
    Vec2 operator*(float k) const { return Vec2(x * k, y * k); }
    float Len() const { return std::sqrt(x * x + y * y); }
};
static float Dist(const Vec2& a, const Vec2& b) { return (a - b).Len(); }
static Vec2 Norm(const Vec2& v) { float l = v.Len(); return l > 1e-6f ? v * (1.0f / l) : Vec2(); }
static float Clampf(float v, float lo, float hi) { return std::min(hi, std::max(lo, v)); }
static std::string Fmt(const char* f, ...) {
    char buf[256];
    va_list ap; va_start(ap, f);
    std::vsnprintf(buf, sizeof buf, f, ap);
    va_end(ap);
    return buf;
}
static bool g_quiet = false;  
